<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <!-- Título de la emisora -->
    <TextView
        android:id="@+id/tvStationName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A VOZ EN CUELLO"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/cinzel_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Logo flotante (Tarjeta suave sin borde duro) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#1C0E1C"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStationName"
        app:layout_constraintBottom_toTopOf="@id/tvSongTitle"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Nombre de la canción -->
    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="A Voz en Cuello"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/visualizer"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Espectro de Audio -->
    <com.radio.generica.VisualizerView
        android:id="@+id/visualizer"
        android:layout_width="140dp"
        android:layout_height="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fabPlayStop"
        android:layout_marginBottom="16dp"/>

    <!-- Rueda de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fabPlayStop"
        android:layout_marginBottom="16dp"/>

    <!-- Botón de Play principal (Blanco con ícono morado) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPlayStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_play"
        app:backgroundTint="#FFFFFF"
        app:tint="#140B14"
        app:fabSize="normal"
        app:maxImageSize="40dp"
        app:elevation="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvVerse"
        android:layout_marginBottom="24dp"/>

    <!-- Cita Bíblica (Solo texto, sin fondo) -->
    <TextView
        android:id="@+id/tvVerse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Isaías 58:1"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.1"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnExit"
        android:layout_marginBottom="8dp"/>

    <!-- Botón de Apagar y Salir -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APAGAR Y SALIR"
        android:textColor="#80FF5252"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="#00000000"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
